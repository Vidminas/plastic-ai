+	for (let length = Math.min(LONGEST_TAG - 1, text.length); length > 0; length--) {
+		const end = text.slice(-length);
+		if (THINK_TAGS.some((tag) => tag !== end && tag.startsWith(end))) return length;
+	}
+	return 0;
+}
+function createThinkTagJoiner() {
+	let held = "";
+	return {
+		push(text) {
+			let buffer = held + text;
+			held = "";
+			const fragment = trailingTagFragment(buffer);
+			if (fragment > 0) {
+				held = buffer.slice(-fragment);
+				buffer = buffer.slice(0, -fragment);
+			}
+			return buffer.split(TAG_PATTERN).filter((part) => part !== "").map((part) => ({
+				text: part,
+				tag: TAG_PATTERN.test(part)
+			}));
+		},
+		flush() {
+			const rest = held;
+			held = "";
+			return rest;
+		}
+	};
